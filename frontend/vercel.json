{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR_RENDER_BACKEND_URL/api/:path*" },
    { "source": "/ws/:path*", "destination": "https://YOUR_RENDER_BACKEND_URL/ws/:path*" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
