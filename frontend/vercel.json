{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cams-backend-gan7.onrender.com/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://cams-backend-gan7.onrender.com/ws/:path*"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}