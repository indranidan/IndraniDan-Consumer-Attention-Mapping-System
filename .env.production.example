# =============================================================================
# Consumer Attention Mapping System (CAMS) — Production Environment Profile
# =============================================================================
# Instructions:
# 1. Copy this template to .env.production:
#    cp .env.production.example .env.production
# 2. Populate all credential placeholders with real secrets from your secrets manager.
# 3. NEVER commit .env.production or files containing plaintext credentials to git.
# =============================================================================

# ── General Runtime Environment ──────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ── Cryptographic Security & JWT Authentication ──────────────────────────────
# Generate a cryptographically strong 256-bit random key:
# Linux/macOS/Git Bash: openssl rand -hex 32
# PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
SECRET_KEY=REPLACE_WITH_SECURE_RANDOMLY_GENERATED_64_HEX_CHAR_SECRET_KEY

# Signing algorithm: HS256 (HMAC-SHA256) or RS256 with public/private keys
ALGORITHM=HS256

# Access token time-to-live in minutes (recommended: 15-60 minutes in production)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Relational Database (PostgreSQL / AWS RDS / Azure Flexible Server) ────────
# Use managed PostgreSQL instance (v14+) with SSL enforced.
# Local Docker: postgresql://postgres:SecurePassword@postgres:5432/consumer_attention_db
# AWS RDS: postgresql://cams_admin:SecurePassword@cams-db.cxyz123.us-east-1.rds.amazonaws.com:5432/cams_prod?sslmode=require
# Azure: postgresql://cams_admin:SecurePassword@cams-pg.postgres.database.azure.com:5432/cams_prod?sslmode=require
DATABASE_URL=postgresql://postgres:STRONG_PASSWORD_HERE@postgres:5432/consumer_attention_db

# PostgreSQL Container Credentials (used by docker-compose if running local stack)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
POSTGRES_DB=consumer_attention_db

# ── Document & Time-Series Database (MongoDB Atlas / Azure Cosmos DB) ────────
# Managed MongoDB cluster (v6.0+) with TLS/SSL enabled.
# Local Docker: mongodb://mongodb:27017
# MongoDB Atlas: mongodb+srv://cams_user:SecurePassword@cams-cluster.xyz.mongodb.net/?retryWrites=true&w=majority&appName=CAMS
# Azure Cosmos DB: mongodb://cams-cosmos:SecurePassword@cams-cosmos.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=consumer_attention_ai_db

# ── In-Memory Cache & Event Bus (Redis / AWS ElastiCache / Azure Managed Redis)
# Managed Redis instance (v7+) with TLS and authentication enabled.
# Local Docker: redis://redis:6379/0
# AWS ElastiCache (Cluster mode disabled): rediss://:AuthToken@cams-redis.xyz.use1.cache.amazonaws.com:6379/0
# Azure Managed Redis: rediss://:Password@cams-cache.redis.cache.windows.net:6380/0
REDIS_URL=redis://redis:6379/0

# ── Google OAuth 2.0 Single Sign-On ──────────────────────────────────────────
# Production OAuth Client ID & Secret configured in Google Cloud Console
# Authorized redirect URI: https://cams.yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-production-google-client-secret

# ── Application URLs & Cross-Origin Resource Sharing (CORS) ──────────────────
# Comma-separated list of fully-qualified origins permitted to query the API.
# Wildcards ("*") are strictly prohibited in production when credentials are included.
FRONTEND_URL=https://cams.yourdomain.com
CORS_ORIGINS=https://cams.yourdomain.com,https://admin.cams.yourdomain.com

# ── Storage & AI Processing Pipelines ────────────────────────────────────────
# Relative or absolute mount path for raw uploads and processed analytical artifacts
AI_OUTPUT_PATH=storage/outputs/ai_jobs
AI_INPUT_PATH=storage/uploads
REPORTS_OUTPUT_PATH=storage/outputs/reports

# Maximum duration in seconds before an asynchronous AI video processing job times out
AI_PIPELINE_TIMEOUT=3600

# Concurrency throttling for simultaneous video inference jobs (adjusted for GPU/CPU limits)
AI_MAX_CONCURRENT_JOBS=2

# Default capture hardware device index if RTSP stream is omitted (0 for primary hardware)
WEBCAM_DEVICE=0
